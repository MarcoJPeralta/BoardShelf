{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "boardshelf",
  "main": "worker/index.ts",
  "workers_dev": true,
  "routes": [
    { "pattern": "boardshelf.online", "custom_domain": true },
    { "pattern": "www.boardshelf.online", "custom_domain": true }
  ],
  "compatibility_date": "2026-10-31",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist/boardshelf/browser",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "FIREBASE_PROJECT_ID": "boardshelf-0000"
  },
  "secrets": { "required": ["BGG_API_TOKEN"] },
  "ratelimits": [
    {
      "name": "BGG_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 }
    }
  ]
}
